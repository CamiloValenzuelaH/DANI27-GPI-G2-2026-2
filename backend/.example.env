# App
APP_ENV=development
APP_NAME=your_app_name
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5433/your_database_name

# CORS
ALLOWED_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173", "http://127.0.0.1:5174", "http://localhost:5174"]

# AI / Keys
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Proveedor de embeddings del backend (se mantiene para recuperación semántica)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Control del auto-seed de ISO chunks al iniciar el backend
AUTO_SEED_ISO_CHUNKS=0

# Encryption
ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# ── Google Workspace (DANI-BE-021) ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/callback

# ── Microsoft 365 (DANI-BE-022) ──
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/connectors/microsoft/callback

# ── GitHub (DANI-BE-024) ──
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/connectors/github/callback

# Twilio (SMS) - use a real Twilio number when deploying
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# SMTP (Email) - replace with real SMTP credentials or MailHog for local testing
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=false
